# Copy to .env and fill in. Never commit .env.

# --- D360 AI engine (agent). Leave blank to run the agent in offline rule-based mode. ---
D360_AI_API_KEY=
# Full chat-completions URL of your D360 AI engine endpoint
D360_AI_ENDPOINT=https://<your-d360-ai-endpoint>/chat/completions
# Token budget per engine call and reasoning depth (low keeps cost down)
AGENT_MAX_COMPLETION_TOKENS=2500
AGENT_REASONING_EFFORT=low

# --- App ---
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=12
DATABASE_PATH=solarclear.db

# --- Grid planning limits (set per your State Commission regulations) ---
VOLTAGE_UPPER_PU=1.06
REVERSE_FLOW_LIMIT_PCT=80
POLICY_CAP_PCT=100
PV_PERFORMANCE_RATIO=0.78

# --- Integrations ---
# open-meteo (live forecast, no key) or clearsky (offline model)
WEATHER_PROVIDER=open-meteo
# Optional: Teams/Slack/any webhook that receives critical alerts
NOTIFY_WEBHOOK_URL=
