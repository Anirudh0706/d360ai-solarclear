# Copy to .env and fill in. Never commit .env.

# --- Azure OpenAI (agent). Leave blank to run the agent in offline rule-based mode. ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<deployment-name-from-azure-ai-foundry>
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Token budget per model call and reasoning depth (low keeps cost down)
AGENT_MAX_COMPLETION_TOKENS=2500
AGENT_REASONING_EFFORT=low

# --- App ---
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=12
DATABASE_PATH=solarclear.db

# --- Grid planning limits (set per your State Commission regulations) ---
VOLTAGE_UPPER_PU=1.06
REVERSE_FLOW_LIMIT_PCT=80
POLICY_CAP_PCT=100
PV_PERFORMANCE_RATIO=0.78

# --- Integrations ---
# open-meteo (live forecast, no key) or clearsky (offline model)
WEATHER_PROVIDER=open-meteo
# Optional: Teams/Slack/any webhook that receives critical alerts
NOTIFY_WEBHOOK_URL=
